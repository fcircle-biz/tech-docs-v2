---
// 404 ページ。GitHub Pages は公開ディレクトリ直下の 404.html を、存在しない URL すべてに返す
// （分類の再編などでURLが変わった旧リンクもここに来る）。案内を表示し、数秒後にトップページへ移動する。
// どの階層の URL でも表示されるため、リンクは base 付きの絶対パスで書く。
// スタンドアロンページのため <head> で Tailwind/Fonts/Font Awesome を自己完結読込する（index.astro と同じ）。
const topHref = import.meta.env.BASE_URL;
const delaySec = 5;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>ページが見つかりません — tech-docs-v2</title>
    <meta name="robots" content="noindex" />
    <!-- JavaScript が無効な環境向けの自動移動（有効な環境では下部のスクリプトが移動させる） -->
    <noscript><meta http-equiv="refresh" content={`${delaySec}; url=${topHref}`} /></noscript>

    <!-- Tailwind CSS CDN（版固定） -->
    <script is:inline src="https://cdn.tailwindcss.com/3.4.17"></script>

    <!-- Google Fonts - Noto Sans JP -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <!-- Font Awesome Icons -->
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
    />

    <style is:inline>
      :root {
        font-family: 'Noto Sans JP', sans-serif;
      }
      .font-mono {
        font-family: 'JetBrains Mono', ui-monospace, monospace;
      }
    </style>
  </head>
  <body class="font-sans bg-slate-50 text-slate-800 antialiased min-h-screen flex flex-col">
    <!-- ヘッダー（グラファイトガラス） -->
    <header class="bg-slate-900 text-white">
      <div class="max-w-screen-xl mx-auto px-4 sm:px-6 lg:px-8 py-4">
        <a href={topHref} class="inline-flex items-center gap-3">
          <div
            class="w-12 h-12 rounded-xl flex items-center justify-center bg-gradient-to-br from-violet-500 to-cyan-500 shadow-lg"
          >
            <i class="fas fa-terminal text-xl text-white"></i>
          </div>
          <div class="flex flex-col">
            <span class="text-lg font-bold tracking-wide font-mono">tech-docs-v2</span>
            <span class="text-xs text-slate-300">IT・ソフトウェア開発の学習ガイド</span>
          </div>
        </a>
      </div>
    </header>

    <main class="flex-1 flex items-center">
      <div class="w-full max-w-xl mx-auto px-4 sm:px-6 py-16 text-center">
        <p
          class="font-mono text-6xl sm:text-7xl font-extrabold bg-gradient-to-r from-violet-500 to-cyan-500 bg-clip-text text-transparent"
        >
          404
        </p>
        <h1 class="mt-4 text-2xl font-bold text-slate-900">ページが見つかりませんでした</h1>
        <p class="mt-4 text-slate-600 leading-relaxed">
          URLが間違っているか、ページが移動・削除された可能性があります。学習ガイドの分類を見直したため、一部のガイドはURLが変わっています。トップページの一覧から目的のガイドを探してください。
        </p>
        <p class="mt-6 text-sm text-slate-500">
          <span id="redirect-countdown">{delaySec}</span> 秒後にトップページへ移動します。
        </p>
        <a
          href={topHref}
          class="mt-6 inline-flex items-center gap-2 rounded-lg bg-slate-900 px-5 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-slate-700 transition-colors"
        >
          <i class="fas fa-house text-xs"></i>
          今すぐトップページへ
        </a>
      </div>
    </main>

    <!-- フッター -->
    <footer class="bg-slate-800 text-slate-300">
      <div class="max-w-screen-xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        <p class="text-sm text-center md:text-left">
          &copy; 2026 F-Circle. All rights reserved.
        </p>
      </div>
    </footer>

    <!-- カウントダウン表示とトップページへの自動移動（履歴に 404 を残さないよう replace を使う） -->
    <script is:inline define:vars={{ topHref, delaySec }}>
      let remaining = delaySec;
      const counter = document.getElementById('redirect-countdown');
      const timer = setInterval(() => {
        remaining -= 1;
        if (counter) counter.textContent = String(Math.max(remaining, 0));
        if (remaining <= 0) {
          clearInterval(timer);
          location.replace(topHref);
        }
      }, 1000);
    </script>
  </body>
</html>
