---
// tech-docs-v2 ランディングページ。
// guideRegistry を走査し、全 TechGuide をカード一覧としてデータ駆動で描画する
// （教材を追加すると自動でカードが増える。ハードコードはしない）。
// スタンドアロンページのため <head> で Tailwind/Fonts/Font Awesome を自己完結読込する。
import { guideRegistry } from '../data/guides';
import type { TechGuide } from '../data/guides';

const base = import.meta.env.BASE_URL;

// 全分類・全 slug を平坦化して TechGuide の配列にする。
const guides = Object.values(guideRegistry).flatMap((bySlug) => Object.values(bySlug));

// 各ガイドの先頭章（章番号 1、無ければ最初の章）へのリンクを作る。
const cards = guides.map((g) => {
  const first = g.chapters.find((c) => c.number === 1) ?? g.chapters[0];
  const href = `${base}guide/${g.category}/${g.slug}/${first.file}`;
  return { g, href };
});

/** 9分類のメタ情報（順序＝表示順）。tech-knowledge-map.md 準拠 */
const CATEGORY_META = [
  { key: 'programming-languages',     label: 'プログラミング言語', icon: 'fa-code' },
  { key: 'web-technologies',          label: 'Web技術',           icon: 'fa-globe' },
  { key: 'development-processes',     label: '開発プロセス',       icon: 'fa-diagram-project' },
  { key: 'design-modeling',           label: '設計・モデリング',   icon: 'fa-compass-drafting' },
  { key: 'cloud-infrastructure',      label: 'クラウド・インフラ', icon: 'fa-cloud' },
  { key: 'data-ai-category',          label: 'データ・AI',        icon: 'fa-brain' },
  { key: 'business-saas',             label: 'ビジネスSaaS',      icon: 'fa-briefcase' },
  { key: 'certification',             label: '資格',              icon: 'fa-certificate' },
  { key: 'business-domain-knowledge', label: '業務ドメイン知識',   icon: 'fa-building-columns' },
] as const;

/** サブグループ（第2セグメント）表示名。未登録キーは機械的フォールバック */
const SUBGROUP_LABELS: Record<string, string> = {
  'java-ecosystem':       'Java エコシステム',
  'javascript-ecosystem': 'JavaScript エコシステム',
  'python-ecosystem':     'Python エコシステム',
  'generative-ai':        '生成AI',
};
const subgroupLabel = (k: string) =>
  SUBGROUP_LABELS[k] ?? k.replace(/-/g, ' ').replace(/\b\w/g, (c) => c.toUpperCase());

// カテゴリ別グループ分け（第1階層＝9分類、第2階層＝サブグループ）のデータ導出。
type Card = { g: TechGuide; href: string };

const topKey = (c: Card) => c.g.category.split('/')[0];
const subKey = (c: Card) => c.g.category.split('/')[1] ?? '';

const byTop = new Map<string, Card[]>();
for (const c of cards) {
  const k = topKey(c);
  if (!byTop.has(k)) byTop.set(k, []);
  byTop.get(k)!.push(c);
}

const buildSection = (key: string, label: string, icon: string) => {
  const list = byTop.get(key)!;
  const direct = list.filter((c) => !subKey(c));
  const subKeys = [...new Set(list.filter((c) => subKey(c)).map(subKey))];
  return {
    key, label, icon,
    id: `cat-${key}`,
    count: list.length,
    direct,
    subgroups: subKeys.map((sk) => ({
      key: sk,
      label: subgroupLabel(sk),
      id: `cat-${key}--${sk}`,
      cards: list.filter((c) => subKey(c) === sk),
    })),
  };
};

// セクション順は CATEGORY_META の配列順。ガイド0件の分類は描画しない。
// CATEGORY_META に無い第1セグメントは末尾に「その他」としてフォールバック。
const known = CATEGORY_META.filter((m) => byTop.has(m.key))
  .map((m) => buildSection(m.key, m.label, m.icon));
const unknownKeys = [...byTop.keys()].filter((k) => !CATEGORY_META.some((m) => m.key === k));
const sections = [...known, ...unknownKeys.map((k) => buildSection(k, 'その他', 'fa-folder'))];

const showNav = sections.length >= 2;

const title = 'tech-docs-v2 — IT・ソフトウェア開発の学習ガイド';
const description =
  'IT・ソフトウェア開発の体系的な日本語学習ガイド集。初心者向けに章立てで学べる技術教材を公開しています。';
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Tailwind CSS CDN（版固定） -->
    <script is:inline src="https://cdn.tailwindcss.com/3.4.17"></script>

    <!-- Google Fonts - Noto Sans JP -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <!-- Font Awesome Icons -->
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
    />

    <style is:inline>
      :root {
        font-family: 'Noto Sans JP', sans-serif;
      }
      .font-mono {
        font-family: 'JetBrains Mono', ui-monospace, monospace;
      }
      html {
        scroll-behavior: smooth;
      }
      @media (prefers-reduced-motion: reduce) {
        html {
          scroll-behavior: auto;
        }
      }
      /* ナビのアクティブ状態（slate-100 / slate-900 / violet-500 と同値） */
      .nav-link.is-active {
        background-color: #f1f5f9;
        color: #0f172a;
        font-weight: 600;
        border-left-color: #8b5cf6;
      }
      .nav-chip.is-active {
        background-color: #0f172a;
        border-color: #0f172a;
        color: #ffffff;
      }
      .nav-chip.is-active .nav-chip-count,
      .nav-chip.is-active .nav-chip-icon {
        color: #cbd5e1;
      }
    </style>
  </head>
  <body class="font-sans bg-slate-50 text-slate-800 antialiased">
    <!-- ヘッダー（グラファイトガラス） -->
    <header class="bg-slate-900 text-white">
      <div class="max-w-screen-xl mx-auto px-4 sm:px-6 lg:px-8 py-4">
        <div class="flex items-center gap-3">
          <div
            class="w-12 h-12 rounded-xl flex items-center justify-center bg-gradient-to-br from-violet-500 to-cyan-500 shadow-lg"
          >
            <i class="fas fa-terminal text-xl text-white"></i>
          </div>
          <div class="flex flex-col">
            <span class="text-lg font-bold tracking-wide font-mono">tech-docs-v2</span>
            <span class="text-xs text-slate-300">IT・ソフトウェア開発の学習ガイド</span>
          </div>
        </div>
      </div>
    </header>

    <main>
      <!-- ヒーロー -->
      <section class="bg-slate-900 text-white">
        <div class="max-w-screen-xl mx-auto px-4 sm:px-6 lg:px-8 pb-16 pt-8">
          <p
            class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/10 text-xs font-semibold tracking-wider uppercase mb-5"
          >
            <i class="fas fa-book-open text-cyan-300"></i>
            Learning Guides
          </p>
          <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold leading-tight">
            <span
              class="bg-gradient-to-r from-violet-400 to-cyan-400 bg-clip-text text-transparent"
              >技術学習ガイド</span
            >
          </h1>
          <p class="mt-5 max-w-2xl text-base sm:text-lg text-slate-300 leading-relaxed">
            初心者向けに章立てで構成された学習教材を公開しています。気になるガイドを選んで、第1章から順に学習を始めましょう。
          </p>
        </div>
      </section>

      <!-- ガイド一覧（カテゴリ別グループ分け＋サイドメニュー） -->
      <section class="max-w-screen-xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16">
        <div class="flex items-end justify-between mb-6">
          <h2 class="text-2xl font-bold text-slate-900">学習ガイド一覧</h2>
          <span class="text-sm text-slate-500">全 {cards.length} 件</span>
        </div>

        {
          cards.length === 0 ? (
            <p class="text-slate-500">現在公開中の学習ガイドはありません。</p>
          ) : (
            <>
              {/* モバイル用：上部固定チップバー（横スクロール） */}
              {showNav && (
                <nav
                  id="category-chip-bar"
                  aria-label="カテゴリナビゲーション"
                  class="lg:hidden sticky top-0 z-30 -mx-4 sm:-mx-6 mb-8 border-b border-slate-200 bg-slate-50 px-4 sm:px-6 py-3"
                >
                  <ul class="flex gap-2 overflow-x-auto pb-1">
                    {sections.map((s) => (
                      <li class="flex-shrink-0">
                        <a
                          href={`#${s.id}`}
                          data-nav-cat={s.key}
                          class="nav-chip inline-flex items-center gap-1.5 rounded-full border border-slate-200 bg-white px-3 py-1.5 text-xs font-medium text-slate-600 transition-colors"
                        >
                          <i class:list={['fas', s.icon, 'text-slate-400 nav-chip-icon']} />
                          {s.label}
                          <span class="nav-chip-count text-slate-400">{s.count}</span>
                        </a>
                      </li>
                    ))}
                  </ul>
                </nav>
              )}

              <div class="lg:flex lg:items-start lg:gap-8">
                {/* デスクトップ用：左サイドメニュー */}
                {showNav && (
                  <aside class="hidden lg:block lg:w-60 flex-shrink-0">
                    <nav
                      aria-labelledby="cat-nav-title"
                      class="sticky top-8 max-h-[calc(100vh-4rem)] overflow-y-auto pr-1"
                    >
                      <p
                        id="cat-nav-title"
                        class="mb-3 px-3 text-xs font-semibold uppercase tracking-wider text-slate-500"
                      >
                        カテゴリ
                      </p>
                      <ul class="space-y-1">
                        {sections.map((s) => (
                          <li>
                            <a
                              href={`#${s.id}`}
                              data-nav-cat={s.key}
                              class="nav-link flex items-center gap-2.5 rounded-lg border-l-2 border-transparent py-2 pl-3 pr-2 text-sm text-slate-600 transition-colors hover:bg-slate-100"
                            >
                              <i class:list={['fas', s.icon, 'w-4 flex-shrink-0 text-center text-slate-400']} />
                              <span class="truncate">{s.label}</span>
                              <span class="ml-auto flex-shrink-0 rounded-full bg-slate-100 px-2 py-0.5 text-xs text-slate-500">
                                {s.count}
                              </span>
                            </a>
                            {s.subgroups.length >= 2 && (
                              <ul class="mb-1 mt-1 space-y-0.5 pl-8">
                                {s.subgroups.map((sg) => (
                                  <li>
                                    <a
                                      href={`#${sg.id}`}
                                      class="block truncate rounded-md px-2 py-1.5 text-xs text-slate-500 transition-colors hover:bg-slate-100 hover:text-slate-700"
                                    >
                                      {sg.label}
                                      <span class="text-slate-400">（{sg.cards.length}）</span>
                                    </a>
                                  </li>
                                ))}
                              </ul>
                            )}
                          </li>
                        ))}
                      </ul>
                    </nav>
                  </aside>
                )}

                {/* カテゴリ別セクション群 */}
                <div class="min-w-0 flex-1 space-y-14">
                  {sections.map((s) => (
                    <section
                      id={s.id}
                      data-cat={s.key}
                      aria-labelledby={`${s.id}-heading`}
                      class="scroll-mt-24 lg:scroll-mt-8"
                    >
                      <h2
                        id={`${s.id}-heading`}
                        class="mb-6 flex items-center gap-3 border-b border-slate-200 pb-3 text-xl font-bold text-slate-900"
                      >
                        <span class="flex h-9 w-9 flex-shrink-0 items-center justify-center rounded-lg bg-gradient-to-br from-violet-500 to-cyan-500 text-white shadow-sm">
                          <i class:list={['fas', s.icon, 'text-base']} />
                        </span>
                        <span class="truncate">{s.label}</span>
                        <span class="ml-auto flex-shrink-0 rounded-full bg-slate-100 px-2.5 py-1 text-xs font-medium text-slate-500">
                          {s.count} 件
                        </span>
                      </h2>

                      {/* 直下ガイド（サブグループ無し） */}
                      {s.direct.length > 0 && (
                        <div class="grid gap-6 sm:grid-cols-2 xl:grid-cols-3">
                          {s.direct.map(({ g, href }) => (
                            <a
                              href={href}
                              class="group relative flex flex-col rounded-2xl bg-white border border-slate-200 shadow-sm hover:shadow-xl hover:-translate-y-1 transition-all duration-300 overflow-hidden"
                            >
                              {/* primary→cyan のヘアラインレール */}
                              <span
                                class="absolute inset-x-0 top-0 h-1 bg-gradient-to-r from-violet-500 to-cyan-500"
                                style={`background: linear-gradient(to right, ${g.primary[500]}, #06b6d4);`}
                              />
                              <div class="p-6 flex flex-col h-full">
                                <div class="flex items-center gap-4 mb-4">
                                  <div
                                    class="w-14 h-14 rounded-xl flex items-center justify-center shadow-md flex-shrink-0"
                                    style={`background: linear-gradient(135deg, ${g.splashStop0}, ${g.splashStop1});`}
                                  >
                                    <i class:list={[g.iconStyle ?? 'fas', g.icon, 'text-2xl', 'text-white']} />
                                  </div>
                                  <div class="min-w-0">
                                    <h3 class="text-lg font-bold text-slate-900 truncate">
                                      {g.techTitle}
                                    </h3>
                                    <p class="text-xs text-slate-500 mt-0.5">{g.categoryLabel}</p>
                                  </div>
                                </div>

                                <div class="flex flex-wrap items-center gap-2 mb-5">
                                  <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full bg-slate-100 text-slate-700 text-xs font-medium">
                                    <i class="fas fa-star text-amber-400 text-[10px]" />
                                    {g.level}
                                  </span>
                                  <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full bg-slate-100 text-slate-700 text-xs font-medium">
                                    <i class="fas fa-clock text-[10px]" />
                                    {g.totalTime}
                                  </span>
                                  <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full bg-slate-100 text-slate-700 text-xs font-medium">
                                    <i class="fas fa-list-ol text-[10px]" />
                                    全{g.chapters.length}章
                                  </span>
                                </div>

                                <span class="mt-auto inline-flex items-center gap-2 text-sm font-semibold text-slate-700 group-hover:text-slate-900 transition-colors">
                                  第1章から学習を始める
                                  <i class="fas fa-arrow-right text-xs group-hover:translate-x-1 transition-transform" />
                                </span>
                              </div>
                            </a>
                          ))}
                        </div>
                      )}

                      {/* サブグループ */}
                      {s.subgroups.length > 0 && (
                        <div class:list={['space-y-10', s.direct.length > 0 && 'mt-10']}>
                          {s.subgroups.map((sg) => (
                            <div id={sg.id} class="scroll-mt-24 lg:scroll-mt-8">
                              <h3 class="mb-4 flex items-center gap-2 text-sm font-semibold uppercase tracking-wider text-slate-500">
                                <span class="h-4 w-1 rounded-full bg-violet-500"></span>
                                {sg.label}
                                <span class="font-normal normal-case text-slate-400">（{sg.cards.length}）</span>
                              </h3>
                              <div class="grid gap-6 sm:grid-cols-2 xl:grid-cols-3">
                                {sg.cards.map(({ g, href }) => (
                                  <a
                                    href={href}
                                    class="group relative flex flex-col rounded-2xl bg-white border border-slate-200 shadow-sm hover:shadow-xl hover:-translate-y-1 transition-all duration-300 overflow-hidden"
                                  >
                                    {/* primary→cyan のヘアラインレール */}
                                    <span
                                      class="absolute inset-x-0 top-0 h-1 bg-gradient-to-r from-violet-500 to-cyan-500"
                                      style={`background: linear-gradient(to right, ${g.primary[500]}, #06b6d4);`}
                                    />
                                    <div class="p-6 flex flex-col h-full">
                                      <div class="flex items-center gap-4 mb-4">
                                        <div
                                          class="w-14 h-14 rounded-xl flex items-center justify-center shadow-md flex-shrink-0"
                                          style={`background: linear-gradient(135deg, ${g.splashStop0}, ${g.splashStop1});`}
                                        >
                                          <i class:list={[g.iconStyle ?? 'fas', g.icon, 'text-2xl', 'text-white']} />
                                        </div>
                                        <div class="min-w-0">
                                          <h3 class="text-lg font-bold text-slate-900 truncate">
                                            {g.techTitle}
                                          </h3>
                                          <p class="text-xs text-slate-500 mt-0.5">{g.categoryLabel}</p>
                                        </div>
                                      </div>

                                      <div class="flex flex-wrap items-center gap-2 mb-5">
                                        <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full bg-slate-100 text-slate-700 text-xs font-medium">
                                          <i class="fas fa-star text-amber-400 text-[10px]" />
                                          {g.level}
                                        </span>
                                        <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full bg-slate-100 text-slate-700 text-xs font-medium">
                                          <i class="fas fa-clock text-[10px]" />
                                          {g.totalTime}
                                        </span>
                                        <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full bg-slate-100 text-slate-700 text-xs font-medium">
                                          <i class="fas fa-list-ol text-[10px]" />
                                          全{g.chapters.length}章
                                        </span>
                                      </div>

                                      <span class="mt-auto inline-flex items-center gap-2 text-sm font-semibold text-slate-700 group-hover:text-slate-900 transition-colors">
                                        第1章から学習を始める
                                        <i class="fas fa-arrow-right text-xs group-hover:translate-x-1 transition-transform" />
                                      </span>
                                    </div>
                                  </a>
                                ))}
                              </div>
                            </div>
                          ))}
                        </div>
                      )}
                    </section>
                  ))}
                </div>
              </div>
            </>
          )
        }
      </section>
    </main>

    <!-- フッター -->
    <footer class="bg-slate-800 text-slate-300">
      <div class="max-w-screen-xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        <div class="flex flex-col md:flex-row items-center justify-between gap-4">
          <p class="text-sm text-center md:text-left">
            &copy; 2026 F-Circle. All rights reserved.<br />
            本資料はAIツールを活用し、人間による編集・監修のもと作成されています。
          </p>
          <div class="flex items-center gap-4">
            <a
              href="https://github.com/fcircle-biz/tech-docs-v2"
              target="_blank"
              rel="noopener"
              class="hover:text-white transition-colors"
            >
              <i class="fab fa-github text-xl"></i>
            </a>
          </div>
        </div>
      </div>
    </footer>

    <!-- カテゴリナビゲーションの scroll-spy（サイドメニュー／チップバーのアクティブ表示同期） -->
    <script is:inline>
      (function () {
        const sections = Array.from(document.querySelectorAll('section[data-cat]'));
        const links = Array.from(document.querySelectorAll('[data-nav-cat]'));
        if (sections.length < 2 || links.length === 0) return;

        const bar = document.getElementById('category-chip-bar');
        let currentKey = null;

        function setActive(key) {
          if (key === currentKey) return;
          currentKey = key;
          links.forEach((a) => {
            const on = a.dataset.navCat === key;
            a.classList.toggle('is-active', on);
            if (on) a.setAttribute('aria-current', 'true');
            else a.removeAttribute('aria-current');
            if (on && bar && bar.contains(a)) {
              const scroller = bar.querySelector('ul');
              scroller.scrollTo({
                left: a.offsetLeft - (scroller.clientWidth - a.offsetWidth) / 2,
                behavior: 'smooth',
              });
            }
          });
        }

        const visible = new Map();
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((e) => visible.set(e.target, e.isIntersecting));
            const hit = sections.find((s) => visible.get(s));
            if (hit) setActive(hit.dataset.cat);
          },
          { rootMargin: '-96px 0px -60% 0px', threshold: 0 }
        );
        sections.forEach((s) => io.observe(s));

        window.addEventListener(
          'scroll',
          () => {
            if (window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 4) {
              setActive(sections[sections.length - 1].dataset.cat);
            }
          },
          { passive: true }
        );

        setActive(sections[0].dataset.cat);
      })();
    </script>
  </body>
</html>
